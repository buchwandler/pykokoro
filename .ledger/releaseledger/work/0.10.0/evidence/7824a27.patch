-            # Strip /slashes/ if present (support legacy format)
-            cleaned_phoneme = phoneme.strip()
-            if cleaned_phoneme.startswith("/") and cleaned_phoneme.endswith("/"):
-                cleaned_phoneme = cleaned_phoneme[1:-1]
