-            if clause_batches:
-                last_idx = len(clause_batches) - 1
-                return [
-                    (
-                        batch_phonemes,
-                        batch_tokens,
-                        generation.pause_clause if idx < last_idx else 0.0,
-                    )
-                    for idx, (batch_phonemes, batch_tokens) in enumerate(clause_batches)
-                ]
