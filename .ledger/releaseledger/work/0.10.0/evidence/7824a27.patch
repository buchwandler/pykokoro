-    values = np.asarray(audio, dtype=np.float64)
-    differences = np.diff(values)
-    peak = float(np.max(np.abs(values)))
-    rms = float(np.sqrt(np.mean(np.square(values))))
-
-    result: dict[str, Any] = {
