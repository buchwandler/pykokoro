-def parse_ssmd_document(
-    text: str,
-    *,
-    render_config: SSMDRenderConfig | None = None,
-    lang: str = "en-us",
-    pause_none: float = DEFAULT_PAUSE_NONE,
-    pause_weak: float = DEFAULT_PAUSE_WEAK,
