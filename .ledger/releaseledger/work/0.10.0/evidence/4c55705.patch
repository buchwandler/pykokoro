-    @staticmethod
-    def _paragraph_boundaries(text: str) -> list[BoundaryEvent]:
-        boundaries: list[BoundaryEvent] = []
-        for match in re.finditer(r"\n\s*\n", text):
-            if match.start() == 0:
-                continue
-            boundary_pos = match.start() - 1
-            if boundary_pos < 0:
-                continue
-            boundaries.append(
-                BoundaryEvent(
-                    pos=boundary_pos,
-                    kind="pause",
-                    duration_s=None,
-                    attrs={"strength": "p"},
-                )
-            )
