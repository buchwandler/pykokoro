+
+
+def test_cache_identity_uses_paths_for_local_models(tmp_path: Path) -> None:
+    model = tmp_path / "model.onnx"
+    voices = tmp_path / "voices.bin"
+    resolved = boundary.ResolvedKokoroModel(
+        ref=None,
+        model_id=None,
+        quality=None,
+        distribution=None,
+        storage_id=None,
+        installation=None,
+        metadata={},
