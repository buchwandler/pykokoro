+        if discard_short_sentence:
+            metadata.pop(SHORT_SENTENCE_META_KEY, None)
+        segment.engine_metadata = metadata or None
+        if clear_word_timings:
+            segment.word_timings = []
+        segment.raw_audio = None
+        segment.processed_audio = None
+        return True
