+
+    def infer(self, token_ids, *, style, speed, seed=None, language=None):
+        _ = style, speed, seed
+        self.calls.append((list(token_ids), language))
+        audio_length, timings = self.responses[len(self.calls) - 1]
+        return SimpleNamespace(
